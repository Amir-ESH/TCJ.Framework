{
  "stryker-config": {
    "reporters": [
      "dots",
      "html",
      "json"
    ],
    "configuration": "Release",
    "mutation-level": "standard",
    "coverage-analysis": "perTest",
    "concurrency": 2,
    "additional-timeout": 5000,
    "thresholds": {
      "high": 80,
      "low": 50,
      "break": 0
    },
    "report-file-name": "mutation-report",
    "ignore-mutations": [],
    "mutate": [
      "**/*.cs",
      "!**/bin/**",
      "!**/obj/**",
      "!**/*.g.cs",
      "!**/*.g.i.cs",
      "!**/*.generated.cs",
      "!**/*.Generated.cs",
      "!**/*.Designer.cs",
      "!**/Migrations/**",
      "!**/AssemblyInfo.cs",
      "!**/GlobalUsings.g.cs",
      "!samples/**",
      "!smoke/**",
      "!tests/**"
    ]
  }
}
