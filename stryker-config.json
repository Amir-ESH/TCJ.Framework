{
  "stryker-config": {
    "reporters": [
      "dots",
      "html",
      "json"
    ],
    "configuration": "Release",
    "test-runner": "mtp",
    "mutation-level": "standard",
    "coverage-analysis": "off",
    "concurrency": 2,
    "additional-timeout": 10000,
    "thresholds": {
      "high": 80,
      "low": 50,
      "break": 0
    },
    "report-file-name": "mutation-report",
    "ignore-mutations": []
  }
}
