<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <WarningsNotAsErrors></WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TCJ.Core" Version="$(TCJNativeAotPackageVersion)" />
    <PackageReference Include="TCJ.Generators" Version="$(TCJNativeAotPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="TCJ.DependencyInjection" Version="$(TCJNativeAotPackageVersion)" />
    <PackageReference Include="TCJ.AspNetCore" Version="$(TCJNativeAotPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ExpectedTcjPackageVersion" Value="$(TCJNativeAotPackageVersion)" />
  </ItemGroup>

  <Target Name="RequireTcjNativeAotPackageVersion" BeforeTargets="Restore">
    <Error Condition="'$(TCJNativeAotPackageVersion)' == ''" Text="TCJNativeAotPackageVersion must be supplied when restoring or publishing the packaged Native AOT smoke test." />
  </Target>
</Project>
