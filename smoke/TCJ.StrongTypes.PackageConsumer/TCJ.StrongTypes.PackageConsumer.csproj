<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <WarningsNotAsErrors></WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TCJ.Core" Version="$(TCJStrongTypesPackageVersion)" />
    <PackageReference Include="TCJ.Generators" Version="$(TCJStrongTypesPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="TCJ.EntityFrameworkCore" Version="$(TCJStrongTypesPackageVersion)" />
    <PackageReference Include="TCJ.AspNetCore" Version="$(TCJStrongTypesPackageVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
  </ItemGroup>

  <Target Name="RequireTcjStrongTypesPackageVersion" BeforeTargets="Restore">
    <Error Condition="'$(TCJStrongTypesPackageVersion)' == ''" Text="TCJStrongTypesPackageVersion must be supplied when restoring the packed Strong Types consumer." />
  </Target>
</Project>
