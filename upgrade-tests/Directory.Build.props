<Project>
  <PropertyGroup>
    <TCJUpgradeTargetFramework Condition="'$(TCJUpgradeTargetFramework)' == ''">net10.0</TCJUpgradeTargetFramework>
    <TargetFramework>$(TCJUpgradeTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <Target Name="RequireTcjUpgradeVersion" BeforeTargets="Restore">
    <Error Condition="'$(TCJUpgradeVersion)' == ''" Text="TCJUpgradeVersion must be supplied when restoring upgrade scenarios." />
  </Target>
</Project>
