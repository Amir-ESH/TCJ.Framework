<Project>
  <Import Project="$(MSBuildThisFileDirectory)PackageValidation.props" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>0.1.0-preview.2</Version>

    <Authors>TCJ Contributors</Authors>
    <Company>TCJ</Company>
    <Product>TCJ</Product>
    <Copyright>Copyright © 2026 TCJ Contributors</Copyright>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Amir-ESH/TCJ.Framework</PackageProjectUrl>
    <PackageReleaseNotes>TCJ Framework preview release. Public APIs may change before 1.0.0. Changelog: https://github.com/Amir-ESH/TCJ.Framework/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <IncludeSymbols>true</IncludeSymbols>
    <IncludeSource>true</IncludeSource>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Amir-ESH/TCJ.Framework.git</RepositoryUrl>

    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PackageVersion" Value="$(Version)" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="$(MSBuildThisFileDirectory)..\README.md"
      Pack="true"
      PackagePath="/"
      Link="README.md" />

    <None
      Include="$(MSBuildThisFileDirectory)..\LICENSE.txt"
      Pack="true"
      PackagePath="/"
      Link="LICENSE.txt" />
  </ItemGroup>
</Project>
