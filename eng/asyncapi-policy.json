{
  "schemaVersion": 1,
  "policyVersion": "1.0",
  "asyncApiSpecificationVersion": "3.1.0",
  "canonicalOutput": {
    "format": "JSON",
    "asyncApiFileName": "asyncapi.json",
    "eventCatalogFileName": "event-catalog.json",
    "relationshipGraphFileName": "catalog-graph.json"
  },
  "outputModes": [
    "referenced",
    "bundled"
  ],
  "validator": {
    "strategy": "Deferred",
    "implementation": null,
    "selectionRequiresGovernanceReview": true
  },
  "versions": {
    "tcjExtensionSchema": "1.0",
    "eventCatalogSchema": "1.0",
    "messagingCatalogInputSchema": 1,
    "governanceContract": "1.0"
  },
  "remoteReferences": {
    "allowed": false
  },
  "secretScanning": {
    "secretValuesAllowed": false,
    "required": true
  },
  "deterministicOutputRequired": true,
  "paths": {
    "package": "src/TCJ.Messaging.AsyncApi/TCJ.Messaging.AsyncApi.csproj",
    "tool": "eng/TCJ.AsyncApi.Tool/TCJ.AsyncApi.Tool.csproj",
    "tests": "eng/tests/test_verify_asyncapi.py",
    "tcjExtensionSchema": "eng/asyncapi-tcj-extensions.schema.json",
    "eventCatalogSchema": "eng/event-catalog.schema.json"
  },
  "expectedGeneratedArtifactRoots": [
    "artifacts/asyncapi",
    "TestResults/AsyncApi"
  ],
  "step52ContractArtifacts": {
    "manifestFileName": "manifest.json",
    "manifestValidation": "TCJ.Messaging.Contracts.MessageContractManifestSerializer",
    "fingerprintValidation": "TCJ.Messaging.Contracts.MessageContractSchemaGenerator",
    "maximumSchemaBytes": 16777216,
    "maximumExampleBytes": 1048576,
    "maximumReferenceDepth": 32,
    "localReferences": {
      "allowed": true,
      "artifactRootConstrained": true,
      "parentTraversalAllowed": false
    },
    "governedExamplesOnly": true
  },
  "generation": {
    "canonicalNewline": "LF",
    "identifierNormalization": "stable-lowercase-kebab-case-with-collision-detection",
    "serverDefaultBehavior": "omit-when-not-explicitly-supplied",
    "maximumChannels": 512,
    "maximumMessages": 512,
    "maximumOperations": 1024,
    "maximumServers": 512,
    "maximumSecuritySchemes": 512,
    "maximumCatalogNodes": 2048,
    "maximumCatalogEdges": 8192,
    "maximumCatalogMetadataStringLength": 2048
  },
  "tcjExtensions": {
    "version": "1.0",
    "schemaPath": "eng/asyncapi-tcj-extensions.schema.json",
    "allowedNames": [
      "x-tcj-extension-version",
      "x-tcj-contract-id",
      "x-tcj-contract-version",
      "x-tcj-schema-fingerprint",
      "x-tcj-owner",
      "x-tcj-lifecycle",
      "x-tcj-compatibility",
      "x-tcj-outbox",
      "x-tcj-inbox",
      "x-tcj-saga",
      "x-tcj-delivery-semantics",
      "x-tcj-ordering-scope",
      "x-tcj-retry-owner",
      "x-tcj-dead-letter",
      "x-tcj-upcaster-path",
      "x-tcj-data-classification",
      "x-tcj-dynamic-destination"
    ],
    "retryOwnerValues": [
      "TransportClient",
      "Outbox",
      "Broker",
      "Inbox",
      "HandlerResilience",
      "Saga",
      "Application",
      "TransportSpecific"
    ],
    "maximumCollectionItems": 64,
    "maximumIdentifierLength": 128,
    "maximumTextLength": 2048,
    "unknownExtensions": "reject",
    "secretBearingMetadata": "reject",
    "transportBindings": "standard-only-when-semantically-explicit-otherwise-governed-extension"
  },
  "eventCatalog": {
    "version": "1.0",
    "schemaPath": "eng/event-catalog.schema.json",
    "requiredOutputs": [
      "event-catalog.json",
      "catalog-graph.json"
    ],
    "scope": "declared-metadata-only",
    "syntheticMarkerRequiredForSyntheticFixtures": true,
    "secretBearingMetadata": "reject",
    "canonicalJson": true,
    "deterministic": true
  }
}
