<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Packaging.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <IncludeSource>false</IncludeSource>
    <PackageId>TCJ.Generators</PackageId>
    <Title>TCJ Generators</Title>
    <Description>Incremental Roslyn source generators for TCJ Framework strong type declarations.</Description>
    <PackageTags>tcj;dotnet;roslyn;source-generator;incremental</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\TCJ.Generators\TCJ.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="..\..\..\src\TCJ.Generators\bin\$(Configuration)\netstandard2.0\TCJ.Generators.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false" />
  </ItemGroup>
</Project>