{
  "schemaVersion": 1,
  "packageStrategy": "existing-packages",
  "deliveryGuarantee": "effectively-once committed database side effects for a stable message ID inside one configured consumer boundary",
  "globalExactlyOnceGuaranteed": false,
  "brokerDelivery": "at-least-once",
  "tableName": "TCJ_InboxMessages",
  "requiredColumns": ["Id", "MessageId", "ConsumerName", "MessageType", "MessageVersion", "PayloadHash", "ReceivedAtUtc", "AttemptCount", "Status", "ProcessedAtUtc", "LastErrorType", "CreatedAtUtc"],
  "operationalColumns": ["Payload", "HeadersJson", "StartedAtUtc", "LockId", "LockedAtUtc", "LockExpiresAtUtc", "NextAttemptAtUtc", "LastError", "DeadLetteredAtUtc", "CorrelationId", "CausationId", "UpdatedAtUtc", "ReplayCount", "LastReplayedAtUtc"],
  "requiredIndexes": ["PK_TCJ_InboxMessages", "UX_TCJ_InboxMessages_ConsumerName_MessageId", "IX_TCJ_InboxMessages_Status_NextAttemptAtUtc", "IX_TCJ_InboxMessages_LockExpiresAtUtc", "IX_TCJ_InboxMessages_ReceivedAtUtc", "IX_TCJ_InboxMessages_ProcessedAtUtc", "IX_TCJ_InboxMessages_MessageType"],
  "statuses": ["Received", "Processing", "Processed", "RetryScheduled", "DeadLettered"],
  "processingOutcomes": ["Acknowledge", "Retry", "DeadLetter", "IgnoreDuplicate"],
  "publicOptions": {
    "ProcessingMode": "Inline",
    "BatchSize": 100,
    "MaxRetryAttempts": 10,
    "PollingIntervalSeconds": 1,
    "LockDurationSeconds": 30,
    "BaseRetryDelaySeconds": 1,
    "MaxRetryDelaySeconds": 300,
    "UseJitter": true,
    "RetentionPeriodDays": 14,
    "CleanupBatchSize": 500,
    "CleanupIntervalSeconds": 3600,
    "StorePayload": true,
    "MaximumPayloadBytes": 1048576,
    "MaximumStoredErrorLength": 1024,
    "BacklogUnhealthyAgeSeconds": 300,
    "DeadLetterUnhealthyThreshold": 1
  },
  "consumerNaming": {"caseSensitive": true, "maximumLength": 128, "allowedCharacters": "letters, numbers, '.', '-' and '_'"},
  "messageTypeNaming": {"maximumLength": 128, "assemblyQualifiedNameAllowed": false, "explicitSchemaVersionRequired": true},
  "serialization": {"default": "System.Text.Json", "customSerializerSupported": true, "arbitraryTypeActivationAllowed": false},
  "headerPolicy": {"defaultAllowlist": ["correlation-id", "causation-id", "content-type", "traceparent", "tracestate"], "authorizationHeadersAllowedByDefault": false},
  "telemetry": {
    "activities": ["tcj.inbox.receive", "tcj.inbox.deduplicate", "tcj.inbox.process", "tcj.inbox.retry", "tcj.inbox.dead_letter", "tcj.inbox.replay", "tcj.inbox.cleanup"],
    "metrics": ["tcj.inbox.messages.received", "tcj.inbox.messages.processed", "tcj.inbox.messages.duplicates", "tcj.inbox.messages.failed", "tcj.inbox.messages.retried", "tcj.inbox.messages.dead_lettered", "tcj.inbox.processing.duration", "tcj.inbox.pending.count", "tcj.inbox.oldest_pending.age"],
    "tags": ["tcj.inbox.consumer", "tcj.inbox.message_type", "tcj.inbox.message_version", "tcj.inbox.outcome", "tcj.inbox.attempt", "tcj.inbox.failure_type", "tcj.inbox.provider", "tcj.canceled"],
    "payloadAllowed": false,
    "rawHeadersAllowed": false,
    "messageIdAllowedByDefault": false
  },
  "healthChecks": ["tcj.inbox.configuration", "tcj.inbox.processor", "tcj.inbox.backlog", "tcj.inbox.dead_letters"],
  "migrationStrategy": "consumer-controlled",
  "automaticMigrations": false,
  "publicReplayEndpointProvided": false
}
