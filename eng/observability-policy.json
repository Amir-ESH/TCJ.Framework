{
  "schemaVersion": 1,
  "minimumTestCount": 12,
  "requiredActivitySources": [
    "TCJ.Core",
    "TCJ.DependencyInjection",
    "TCJ.EntityFrameworkCore",
    "TCJ.EntityFrameworkCore.SqlServer",
    "TCJ.AspNetCore"
  ],
  "requiredMeters": [
    "TCJ.Core",
    "TCJ.DependencyInjection",
    "TCJ.EntityFrameworkCore",
    "TCJ.EntityFrameworkCore.SqlServer",
    "TCJ.AspNetCore"
  ],
  "requiredActivities": [
    "tcj.domain_event.dispatch",
    "tcj.domain_event.handle",
    "tcj.di.scan",
    "tcj.di.register",
    "tcj.repository.query",
    "tcj.repository.get",
    "tcj.repository.add",
    "tcj.repository.update",
    "tcj.repository.delete",
    "tcj.unit_of_work.commit",
    "tcj.db.transaction.begin",
    "tcj.db.transaction.commit",
    "tcj.db.transaction.rollback",
    "tcj.db.sqlserver.configure",
    "tcj.aspnetcore.exception.handle"
  ],
  "requiredMetrics": [
    "tcj.domain_events.dispatched",
    "tcj.domain_event_handlers.completed",
    "tcj.domain_event_handlers.failed",
    "tcj.domain_event.dispatch.duration",
    "tcj.domain_event.handler.duration",
    "tcj.repository.operations",
    "tcj.repository.operation.duration",
    "tcj.unit_of_work.commits",
    "tcj.unit_of_work.rollbacks",
    "tcj.unit_of_work.commit.duration",
    "tcj.aspnetcore.exceptions.handled",
    "tcj.aspnetcore.exception_handler.duration"
  ],
  "allowedMetricDimensions": [
    "tcj.operation.name",
    "tcj.operation.outcome",
    "tcj.db.provider",
    "tcj.exception.category",
    "tcj.http.status_code"
  ],
  "forbiddenTagPatterns": [
    "password",
    "token",
    "connection_string",
    "request_body",
    "raw_sql",
    "entity.id",
    "user.id",
    "tenant"
  ],
  "sensitiveTestMarkers": [
    "TCJ_TEST_PASSWORD_MARKER",
    "TCJ_TEST_TOKEN_MARKER",
    "TCJ_TEST_CONNECTION_STRING_MARKER"
  ],
  "requireVersionedSources": true,
  "requireDisabledOverheadBenchmark": true,
  "requireFailureTests": true,
  "requireCancellationTests": true,
  "requireTracePropagationTests": true,
  "requireSensitiveDataTests": true
}
