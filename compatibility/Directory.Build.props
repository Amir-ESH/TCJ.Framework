<Project>
  <PropertyGroup>
    <TCJCompatibilityTargetFramework Condition="'$(TCJCompatibilityTargetFramework)' == ''">net10.0</TCJCompatibilityTargetFramework>
    <TargetFramework>$(TCJCompatibilityTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <Target Name="RequireTcjCompatibilityVersion" BeforeTargets="Restore">
    <Error Condition="'$(TCJCompatibilityVersion)' == ''" Text="TCJCompatibilityVersion must be supplied when restoring compatibility consumers." />
  </Target>
</Project>
