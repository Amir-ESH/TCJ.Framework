root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
tab_width = 4

# Using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning

# Namespace and type style
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = false:silent
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# Qualification
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Built-in types
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# var preferences
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expressions
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_readonly_field = true:suggestion

# Braces and layout
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# XML documentation will be enforced later
dotnet_diagnostic.CS1591.severity = none

[*.{json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

[*.{csproj,props,targets,slnx,xml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[src/TCJ.Core/DomainEvents/IDomainEventHandler.cs]
dotnet_diagnostic.CA1711.severity = none

# TCJ analyzer and generator diagnostic governance
[src/TCJ.Analyzers/**.cs]
dotnet_diagnostic.RS1018.severity = error
dotnet_diagnostic.RS1019.severity = error
dotnet_diagnostic.RS1020.severity = error
dotnet_diagnostic.RS1021.severity = error
dotnet_analyzer_diagnostic.category-MicrosoftCodeAnalysisReleaseTracking.severity = error

[src/TCJ.Generators/**.cs]
dotnet_diagnostic.RS1018.severity = error
dotnet_diagnostic.RS1019.severity = error
dotnet_diagnostic.RS1020.severity = error
dotnet_diagnostic.RS1021.severity = error
dotnet_analyzer_diagnostic.category-MicrosoftCodeAnalysisReleaseTracking.severity = error
