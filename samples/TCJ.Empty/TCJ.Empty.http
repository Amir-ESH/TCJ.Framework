@TCJ.Empty_HostAddress = http://localhost:5128
@productId = 00000000-0000-0000-0000-000000000000

### List seeded products
GET {{TCJ.Empty_HostAddress}}/api/products
Accept: application/json

### Create a product
POST {{TCJ.Empty_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "4K Monitor",
  "price": 449.99
}

### Get a product
GET {{TCJ.Empty_HostAddress}}/api/products/{{productId}}
Accept: application/json

### Update a product
PUT {{TCJ.Empty_HostAddress}}/api/products/{{productId}}
Content-Type: application/json

{
  "name": "4K Monitor Pro",
  "price": 529.99
}

### Soft-delete a product
DELETE {{TCJ.Empty_HostAddress}}/api/products/{{productId}}

### Restore a product
POST {{TCJ.Empty_HostAddress}}/api/products/{{productId}}/restore
