<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\Packaging.props" />

  <PropertyGroup>
    <PackageId>TCJ.AspNetCore</PackageId>
    <Title>TCJ ASP.NET Core</Title>
    <Description>ASP.NET Core integration for TCJ, including current-user resolution, Result-to-HTTP mapping, Problem Details, and centralized exception handling.</Description>
    <PackageTags>tcj;dotnet;aspnetcore;web-api;problem-details;result-pattern;exception-handling</PackageTags>

    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TCJ.Core\TCJ.Core.csproj" />
  </ItemGroup>
</Project>
