<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\Packaging.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>TCJ.Generators</PackageId>
    <Title>TCJ Generators</Title>
    <Description>Incremental source generators for TCJ strong type contracts.</Description>
    <PackageTags>tcj;dotnet;source-generator;roslyn;strong-types</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <IsAotCompatible>false</IsAotCompatible>
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../TCJ.Analyzers/DiagnosticCategoryAndIdRanges.txt" Link="DiagnosticCategoryAndIdRanges.txt" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <None Include="$(MSBuildProjectDirectory)\..\..\LICENSE.txt" Pack="true" PackagePath="/" Link="LICENSE.txt" />
    <None Include="$(MSBuildProjectDirectory)\..\..\docs\packages\TCJ.Generators.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
